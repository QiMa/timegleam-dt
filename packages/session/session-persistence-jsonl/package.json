{
  "name": "@hy/dsh-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the Huayu AI",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-persistence": "workspace:*",
    "@hy/cordis": "workspace:~"
  },
  "dependencies": {
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-session-format": "workspace:*",
    "@hy/dsh-session-format-catalog": "workspace:*",
    "@hy/dsh-session-format-v3-to-v4": "workspace:*",
    "@hy/node-addon-system": "workspace:~",
    "@hy/schemastery": "workspace:~",
    "koffi": "3.1.1"
  },
  "devDependencies": {
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-format-v0-to-v1": "workspace:*",
    "@hy/dsh-session-persistence": "workspace:*",
    "@hy/cordis": "workspace:~"
  }
}
