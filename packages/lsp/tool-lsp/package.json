{
  "name": "@hy/dsh-tool-lsp",
  "description": "Model-facing lsp tool over the DeepSeek Harness LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-lsp": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-timeout": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@hy/dsh-util-values": "workspace:*",
    "@hy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-fs-local": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-lsp": "workspace:*",
    "@hy/dsh-lsp-stdio": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-subprocess-local": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-timeout": "workspace:*",
    "@hy/dsh-tool-call-timeout-policy": "workspace:*",
    "@hy/dsh-tool-executor-native": "workspace:*",
    "@hy/dsh-tool-testkit": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-working-directory": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*"
  }
}
