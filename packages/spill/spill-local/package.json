{
  "name": "@hy/dsh-spill-local",
  "description": "Local-filesystem implementation of the Huayu AI spill storage seam (private session-scoped files)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/dsh-spill": "workspace:*",
    "@hy/cordis": "workspace:~"
  },
  "dependencies": {
    "@hy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hy/cordis-plugin-include": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-brand": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-spill": "workspace:*",
    "@hy/cordis": "workspace:~"
  }
}
