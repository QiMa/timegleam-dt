{
  "name": "@hy/dsh-client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hy/dsh-api-session-controller",
        "@hy/dsh-client-locale",
        "@hy/dsh-client-ui-conversation",
        "@hy/dsh-client-ui-renderer",
        "@hy/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-client-locale": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-conversation": "workspace:*",
    "@hy/dsh-util-values": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-compaction": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/cordis": "workspace:~",
    "@types/react-dom": "~18.3.0",
    "@hy/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@hy/dsh-client-store": "workspace:*",
    "@hy/dsh-client-ui-chat": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-api-session-controller": "workspace:*",
    "@hy/dsh-client-ui-renderer": "workspace:*",
    "@hy/dsh-client-ui-session": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-attachment": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "diff": "^9.0.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
