{
  "name": "@hy/dsh-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hy/dsh-api-remote-access",
        "@hy/dsh-api-remotes",
        "@hy/dsh-api-session-controller",
        "@hy/dsh-api-workspace-controller",
        "@hy/dsh-client-connection",
        "@hy/dsh-client-locale",
        "@hy/dsh-client-shortcuts",
        "@hy/dsh-client-ui-conversation",
        "@hy/dsh-client-ui-layout",
        "@hy/dsh-client-ui-renderer",
        "@hy/dsh-client-ui-session",
        "@hy/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-api-remote-access": "workspace:*",
    "@hy/cordis": "workspace:~",
    "@hy/dsh-api-remotes": "workspace:*",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-preset-registry": "workspace:*",
    "@hy/dsh-api-session-controller": "workspace:*",
    "@hy/dsh-api-workspace-controller": "workspace:*",
    "@hy/dsh-client-connection": "workspace:*",
    "@hy/dsh-client-locale": "workspace:*",
    "@hy/dsh-client-store": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-client-ui-conversation": "workspace:*",
    "@hy/dsh-client-ui-layout": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-renderer": "workspace:*",
    "@hy/dsh-client-ui-session": "workspace:*",
    "@hy/dsh-client-ui-sidebar": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-jobs": "workspace:*",
    "@hy/dsh-schedule": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*",
    "@hy/dsh-util-values": "workspace:*",
    "@hy/dsh-util-workspace-path": "workspace:*",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@hy/dsh-client-shortcuts": "workspace:*",
    "@hy/dsh-client-product-analytics": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
