{
  "name": "@hy/dsh-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hy/dsh-api-remotes",
        "@hy/dsh-api-session-controller",
        "@hy/dsh-client-connection",
        "@hy/dsh-client-locale",
        "@hy/dsh-client-ui-conversation",
        "@hy/dsh-client-ui-renderer",
        "@hy/dsh-client-ui-input-trigger",
        "@hy/dsh-client-ui-sidebar-right",
        "@hy/dsh-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-api-remotes": "workspace:*",
    "@hy/dsh-api-session-controller": "workspace:*",
    "@hy/dsh-client-connection": "workspace:*",
    "@hy/dsh-client-locale": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-client-ui-conversation": "workspace:*",
    "react": "^18.2.0",
    "@hy/dsh-client-ui-input-trigger": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-renderer": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-file-reference": "workspace:*",
    "@hy/dsh-session-reference": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*",
    "@hy/dsh-util-workspace-path": "workspace:*",
    "@hy/cordis": "workspace:~",
    "@hy/dsh-client-ui-sidebar-right": "workspace:*",
    "@hy/dsh-client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
