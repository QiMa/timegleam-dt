{
  "name": "@hy/dsh-client-ui-settings-plugin-inventory",
  "description": "Read-only Cordis Loader inventory tab in Web Plugins settings",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hy/dsh-api-remotes",
        "@hy/dsh-client-ui-settings",
        "@hy/dsh-client-locale",
        "@hy/dsh-client-ui-agent-preset",
        "@hy/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-api-remotes": "workspace:*",
    "@hy/dsh-client-locale": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-client-ui-agent-preset": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-settings": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-package-manifest": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@hy/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@hy/dsh-client-ui-renderer": "workspace:*",
    "@hy/dsh-agent-preset-registry": "workspace:*",
    "@hy/dsh-client-modules": "workspace:*",
    "@hy/dsh-client-store": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
