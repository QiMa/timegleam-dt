{
  "name": "@hy/dsh-client-ui-deepseek-model-label-1017",
  "description": "Temporary 1017 release badge for official DeepSeek Flash model labels",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-deepseek-model-label-1017"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hy/dsh-client-ui-model-selection",
        "@hy/dsh-client-ui-renderer",
        "@hy/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-client-locale": "workspace:*",
    "@hy/dsh-client-ui-model-selection": "workspace:*",
    "@hy/dsh-client-ui-renderer": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
