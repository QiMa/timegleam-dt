{
  "name": "@hy/dsh-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@hy/dsh-brand": "workspace:*",
    "@hy/dsh-cmdline": "workspace:*",
    "@hy/dsh-util-values": "workspace:*",
    "@hy/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-default-model": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-query": "workspace:*",
    "@hy/dsh-fs": "workspace:*",
    "@hy/dsh-permission-presets": "workspace:*",
    "@hy/dsh-sandbox-policy": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-user-approval": "workspace:*"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-default-model": "workspace:*",
    "@hy/dsh-agent-loop": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-query": "workspace:*",
    "@hy/dsh-fs": "workspace:*",
    "@hy/dsh-permission-presets": "workspace:*",
    "@hy/dsh-sandbox-policy": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hy/dsh-permission-presets": {
      "optional": true
    },
    "@hy/dsh-sandbox-policy": {
      "optional": true
    },
    "@hy/dsh-subagent": {
      "optional": true
    }
  }
}
