{
  "name": "@hy/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Huayu AI SDK clients",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hy/dsh-brand": "workspace:*",
    "@hy/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-attachment": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-llm-deepseek-api-key": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-sdk-protocol": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-loop": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*",
    "@hy/dsh-attachment": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-llm-deepseek-api-key": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-sdk-protocol": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-persistence-jsonl": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-working-directory": "workspace:*"
  }
}
