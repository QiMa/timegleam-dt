{
  "name": "@hy/dsh-storage-json",
  "description": "JSON file KV storage backend for the Huayu AI storage hub",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/storage/storage-json"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/dsh-storage": "workspace:*",
    "@hy/cordis": "workspace:~"
  },
  "dependencies": {
    "@hy/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-storage": "workspace:*",
    "@hy/cordis": "workspace:~"
  }
}
