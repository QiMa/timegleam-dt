{
  "name": "@hy/dsh-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@hy/dsh-brand": "workspace:*",
    "@hy/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-attachment": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-mcp-client": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-persistence": "workspace:*",
    "@hy/dsh-token-meter": "workspace:*",
    "@hy/dsh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hy/dsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-loop": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*",
    "@hy/dsh-attachment": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-mcp-client": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-persistence": "workspace:*",
    "@hy/dsh-session-persistence-jsonl": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-token-meter": "workspace:*",
    "@hy/dsh-tool-testkit": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-user-approval": "workspace:*"
  }
}
