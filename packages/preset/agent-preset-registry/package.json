{
  "name": "@hy/dsh-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis-plugin-include": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-settings": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*",
    "@hy/cordis": "workspace:~"
  },
  "dependencies": {
    "@hy/dsh-app-boot": "workspace:*",
    "@hy/schemastery": "workspace:~",
    "zod": "4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@hy/cordis-plugin-group": "workspace:~",
    "@hy/cordis-plugin-include": "workspace:~",
    "@hy/cordis-plugin-loader": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-loop": "workspace:*",
    "@hy/dsh-atomic-write": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-settings": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*",
    "@hy/cordis": "workspace:~",
    "@hy/dsh-hmr": "workspace:*",
    "@hy/dsh-sandbox": "workspace:*",
    "@hy/dsh-sandbox-policy": "workspace:*",
    "@hy/dsh-user-approval": "workspace:*",
    "@hy/dsh-agent-preset": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
