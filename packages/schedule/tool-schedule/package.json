{
  "name": "@hy/dsh-tool-schedule",
  "description": "Model-facing scheduled task tools (schedule_create, schedule_list, schedule_view, schedule_edit) over the Host ctx.schedule service",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/schedule/tool-schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-schedule": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-ptc-runtime": "workspace:*",
    "@hy/dsh-schedule": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-subagent": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-tool-executor-ptc": "workspace:*",
    "@hy/dsh-tool-testkit": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-agent-preset-registry": "workspace:*"
  }
}
