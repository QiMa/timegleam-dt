{
  "name": "@hy/dsh-terminal",
  "description": "Persistent PTY session seam for the DeepSeek Harness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-brand": "workspace:*",
    "@hy/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*",
    "@hy/dsh-brand": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/cordis": "workspace:~"
  }
}
