{
  "name": "@hy/dsh-cordis-host-runner",
  "description": "Dynamic package definition registry, host-half sandbox lifecycle, and invoke handler table for model-mounted dual-half packages",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/cordis-host-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hy/dsh-util-values": "workspace:*",
    "@hy/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-brand": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/cordis-plugin-timer": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-api-gateway": "workspace:*",
    "@hy/dsh-api-remote-access": "workspace:*",
    "@hy/dsh-brand": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-scope": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-tool-executor-native": "workspace:*",
    "@hy/dsh-tool-testkit": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-typert-protocol": "workspace:*"
  }
}
