{
  "name": "@hy/dsh-time-context",
  "description": "Durable per-step context with the current time and elapsed time",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hy/dsh-util-values": "workspace:*",
    "@hy/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-util-time": "workspace:*"
  },
  "devDependencies": {
    "@hy/cordis": "workspace:~",
    "@hy/dsh-agent": "workspace:*",
    "@hy/dsh-agent-loop": "workspace:*",
    "@hy/dsh-agent-loop-testkit": "workspace:*",
    "@hy/dsh-app-boot": "workspace:*",
    "@hy/dsh-bash-local": "workspace:*",
    "@hy/dsh-llm": "workspace:*",
    "@hy/dsh-loader-smoke": "workspace:*",
    "@hy/dsh-session": "workspace:*",
    "@hy/dsh-session-checkpoint-policy": "workspace:*",
    "@hy/dsh-session-persistence-jsonl": "workspace:*",
    "@hy/dsh-session-projection": "workspace:*",
    "@hy/dsh-subprocess-local": "workspace:*",
    "@hy/dsh-system-prompt": "workspace:*",
    "@hy/dsh-tool-testkit": "workspace:*",
    "@hy/dsh-tools": "workspace:*",
    "@hy/dsh-util-time": "workspace:*"
  }
}
