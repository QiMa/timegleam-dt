# Copy to airgap.env in the same machine configuration directory and fill in the values.
# Public AirGap distribution configuration. No signing or upload credentials belong here.
DSH_DESKTOP_APP_ID=com.timegleam.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=airgap
# Enterprise builds publish to the separate timegleam-enterprise catalog; standard builds use timegleam.
DSH_DESKTOP_EDITION=enterprise
# Public base URL clients use to reach the AirGap repo, including the base path.
# Closed-network clients may instead override DSH_DESKTOP_UPDATE_FEED_URL at runtime.
AIRGAP_BASE_URL=https://lanhc.com/lanhc/airgap
# Optional absolute private cache directory. Omit to retain the account default cache.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
