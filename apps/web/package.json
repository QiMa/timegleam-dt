{
  "name": "@hy/dsh-web-frontend",
  "description": "Web application entry: vite build over the @hy/dsh-client-web shell library; dist/ served by apps/cli's dsh web",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @hy/dsh-experimental-webworker-runtime exec tsdown && pnpm --filter @hy/dsh-experimental-webworker-packer exec tsdown && vite build && dsh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@hy/cordis-plugin-group": "workspace:~",
    "@hy/dsh-client-modules": "workspace:*",
    "@hy/dsh-client-store": "workspace:*",
    "@hy/dsh-llm-mock-server": "workspace:*",
    "@hy/dsh-client-test-runtime": "workspace:*",
    "@hy/dsh-client-ui-deliverables": "workspace:*",
    "@hy/dsh-client-ui-dockkit": "workspace:*",
    "@hy/dsh-client-ui-primitives": "workspace:*",
    "@hy/dsh-client-ui-slots": "workspace:*",
    "@hy/dsh-client-web": "workspace:*",
    "@hy/dsh-cmdline": "workspace:*",
    "@hy/dsh-pwsh-local": "workspace:*",
    "@hy/dsh-experimental-agent-team": "workspace:*",
    "@hy/dsh-experimental-webworker-packer": "workspace:*",
    "@hy/dsh-experimental-webworker-runtime": "workspace:*",
    "@hy/dsh-remote-mock": "workspace:*",
    "@hy/dsh-session-projection-cache": "workspace:*",
    "@hy/dsh-util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@hy/dsh-client-ui-theme": "workspace:*",
    "@hy/dsh-launch-environment": "workspace:*",
    "@hy/dsh-workspace-changes": "workspace:*",
    "@hy/dsh-subprocess-local": "workspace:*",
    "@hy/dsh-experimental-auto-review": "workspace:*",
    "@hy/dsh-experimental-speech-to-text": "workspace:*",
    "@hy/dsh-experimental-voice-input-bundle": "workspace:*",
    "@hy/dsh-experimental-cot-translation-bundle": "workspace:*",
    "@hy/dsh-experimental-worktree": "workspace:*",
    "@hy/dsh-experimental-plugin-market-bundle": "workspace:*"
  }
}
